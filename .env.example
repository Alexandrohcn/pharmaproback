# Copia este archivo como .env y completa los valores reales solo en tu maquina o VPS.
# No coloques secretos reales en este archivo.

ConnectionStrings__SupabaseConnection=Host=TU_HOST;Port=5432;Database=postgres;Username=postgres;Password=TU_PASSWORD;Ssl Mode=Require;Trust Server Certificate=true

# Opcional si luego se usa el SDK/API de Supabase directamente.
Supabase__Url=https://TU_PROYECTO.supabase.co
Supabase__AnonKey=TU_ANON_KEY

# Puerto usado en VPS/containers. En local puedes omitirlo y usar launchSettings.json.
PORT=5083

# CORS para frontend local o dominio desplegado.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
